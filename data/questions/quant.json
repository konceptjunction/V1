  "year": "",
  "level": "easy",
  "q": {
   "en": "Find the simple interest on ₹5000 at 8% per annum for 3 years.",
   "te": "₹5000 పై సంవత్సరానికి 8% సాధారణ వడ్డీ రేటుతో 3 సంవత్సరాలకు వడ్డీ ఎంత?"
  },
  "o": {
   "en": [
    "₹1000",
    "₹1200",
    "₹1250",
    "₹1400"
   ],
   "te": [
    "₹1000",
    "₹1200",
    "₹1250",
    "₹1400"
   ]
  },
  "a": 1,
  "e": {
   "en": "$SI=\\dfrac{PRT}{100}=\\dfrac{5000\\times 8\\times 3}{100}=1200$, i.e. ₹1200.",
   "te": "$SI=\\dfrac{PRT}{100}=\\dfrac{5000\\times 8\\times 3}{100}=1200$, అంటే ₹1200."
  },
